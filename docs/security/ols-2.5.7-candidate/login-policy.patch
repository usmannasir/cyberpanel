+<?php
+namespace LSWebAdmin\Auth;
+
+use LSWebAdmin\Config\Parser\PlainConfParser;
+
+/** Read login policy without bootstrapping authenticated controllers or migrating files. */
+class AdminLoginConfig
+{
+    public static function load($path)
+    {
+        if (!is_file($path) || !is_readable($path)) {
+            return [];
+        }
+        try {
+            $parser = new PlainConfParser();
+            $root = $parser->Parse($path);
+            if ($root->HasFatalErr()) {
+                return [];
+            }
+        } catch (\Throwable $error) {
+            // A read/parse failure must preserve the built-in login protection.
+            return [];
+        }
+        $config = [];
+        $fields = [
+            'throttleEnabled' => ['enabled', 0, 1],
+            'throttleMaxFailures' => ['maxFailures', 1, 10],
+            'throttleBlockWindow' => ['blockWindow', 60, 86400],
+            'throttleMaxBackoff' => ['maxBackoff', 60, 86400],
+            'loginHistoryRetention' => ['historyRetention', 1, 365],
+        ];
+        foreach ($fields as $name => $spec) {
+            $value = $root->GetChildVal($name);
+            if ($value === null) {
+                continue;
+            }
+            if (!preg_match('/^[0-9]+$/D', (string) $value)
+                || (int) $value < $spec[1] || (int) $value > $spec[2]) {
+                return [];
+            }
+            $config[$spec[0]] = (int) $value;
+        }
+        $window = isset($config['blockWindow']) ? $config['blockWindow'] : 900;
+        $backoff = isset($config['maxBackoff']) ? $config['maxBackoff'] : 14400;
+        if ($backoff < $window) {
+            return [];
+        }
+        return $config;
+    }
+}
