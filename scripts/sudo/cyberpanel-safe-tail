#!/usr/bin/env bash
# Allowlisted wrapper for lscpd: tail log files only (--lines / --file).
set -euo pipefail
lines="50"
file=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --lines)
      lines="${2:-50}"
      shift 2
      ;;
    --file)
      file="${2:-}"
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done
if [[ -z "$file" ]]; then
  echo "cyberpanel-safe-tail: missing --file" >&2
  exit 1
fi
case "$file" in
  /*) ;;
  *)
    echo "cyberpanel-safe-tail: file must be absolute path" >&2
    exit 1
    ;;
esac
if [[ ! -f "$file" ]]; then
  echo "cyberpanel-safe-tail: not a file" >&2
  exit 1
fi
exec /usr/bin/tail -n "$lines" "$file"
