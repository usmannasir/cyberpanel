#!/usr/bin/env bash
# Allowlisted wrapper for lscpd: pm2 read-only style commands only.
set -euo pipefail
PM2=""
PM2=$(command -v pm2 || true)
if [[ -z "$PM2" ]]; then
  echo "cyberpanel-safe-pm2: pm2 not found" >&2
  exit 1
fi
if [[ $# -lt 1 ]]; then
  echo "cyberpanel-safe-pm2: missing arguments" >&2
  exit 1
fi
sub="$1"
case "$sub" in
  list|status|jlist|prettylist|describe|info|show)
    exec "$PM2" "$@"
    ;;
  logs)
    exec "$PM2" "$@"
    ;;
  *)
    echo "cyberpanel-safe-pm2: subcommand not allowed: $sub" >&2
    exit 1
    ;;
esac
