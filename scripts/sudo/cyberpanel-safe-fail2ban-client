#!/usr/bin/env bash
# Allowlisted wrapper for lscpd: fail2ban-client read-only commands.
set -euo pipefail
FB=""
FB=$(command -v fail2ban-client || true)
if [[ -z "$FB" ]]; then
  echo "cyberpanel-safe-fail2ban-client: fail2ban-client not found" >&2
  exit 1
fi
if [[ $# -lt 1 ]]; then
  echo "cyberpanel-safe-fail2ban-client: missing arguments" >&2
  exit 1
fi
sub="$1"
case "$sub" in
  status|ping|get)
    exec "$FB" "$@"
    ;;
  *)
    echo "cyberpanel-safe-fail2ban-client: subcommand not allowed: $sub" >&2
    exit 1
    ;;
esac
